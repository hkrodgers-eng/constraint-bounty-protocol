{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CBP Agent Contribution v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "submission_id",
    "challenge_id",
    "proposed_workflow_status",
    "evidence_items"
  ],
  "properties": {
    "protocol_version": {"const": "0.1"},
    "submission_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{6,80}$"},
    "challenge_id": {"type": "string", "pattern": "^[0-9]{3}_[a-z0-9_]+$"},
    "proposed_workflow_status": {"enum": ["OPEN", "BLOCKED", "INFEASIBLE", "SOLVED"]},
    "evidence_items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_state", "description"],
        "properties": {
          "evidence_state": {"enum": [
            "VERIFIED_FACT",
            "PROPOSED_SOLUTION",
            "UNKNOWN_DATA",
            "BLOCKED",
            "REQUIRES_AUTHORIZATION",
            "VERIFIED_AGREEMENT",
            "COMPLETED_DELIVERY"
          ]},
          "description": {"type": "string", "minLength": 15},
          "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "justification": {"type": "string", "minLength": 8},
          "verification_reference": {"type": "string", "minLength": 8},
          "cost_verification_reference": {"type": "string", "minLength": 8}
        },
        "allOf": [
          {
            "if": {"properties": {"evidence_state": {"const": "VERIFIED_FACT"}}, "required": ["evidence_state"]},
            "then": {"required": ["source_url"]}
          },
          {
            "if": {"properties": {"evidence_state": {"const": "VERIFIED_AGREEMENT"}}, "required": ["evidence_state"]},
            "then": {"required": ["verification_reference", "cost_verification_reference"]}
          },
          {
            "if": {"properties": {"evidence_state": {"const": "COMPLETED_DELIVERY"}}, "required": ["evidence_state"]},
            "then": {"required": ["verification_reference"]}
          },
          {
            "if": {
              "properties": {"evidence_state": {"enum": [
                "PROPOSED_SOLUTION",
                "BLOCKED",
                "REQUIRES_AUTHORIZATION"
              ]}},
              "required": ["evidence_state"]
            },
            "then": {"required": ["justification"]}
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"proposed_workflow_status": {"const": "SOLVED"}}, "required": ["proposed_workflow_status"]},
      "then": {"properties": {"evidence_items": {
        "contains": {
          "type": "object",
          "properties": {"evidence_state": {"const": "COMPLETED_DELIVERY"}},
          "required": ["evidence_state"]
        }
      }}}
    }
  ]
}
