{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CBP Challenge Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "challenge_id",
    "title",
    "authoritative_status",
    "objective",
    "origin",
    "destination",
    "payload",
    "ready_date",
    "delivery_deadline",
    "absolute_constraints",
    "verified_inputs",
    "unknowns",
    "verification_requirements"
  ],
  "properties": {
    "protocol_version": {"const": "0.1"},
    "challenge_id": {"type": "string", "pattern": "^[0-9]{3}_[a-z0-9_]+$"},
    "title": {"type": "string", "minLength": 8},
    "authoritative_status": {"enum": ["OPEN", "BLOCKED", "INFEASIBLE", "SOLVED"]},
    "objective": {"type": "string", "minLength": 20},
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "exact_location"],
      "properties": {
        "region": {"type": "string", "minLength": 2},
        "exact_location": {"type": ["string", "null"]}
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "confirmed_facility", "consent_verified"],
      "properties": {
        "region": {"type": "string", "minLength": 2},
        "confirmed_facility": {"type": ["string", "null"]},
        "consent_verified": {"type": "boolean"}
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quantity", "weight_kg", "volume_m3"],
      "properties": {
        "quantity": {"type": ["integer", "null"], "minimum": 1},
        "weight_kg": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "volume_m3": {"type": ["number", "null"], "exclusiveMinimum": 0}
      }
    },
    "ready_date": {"type": ["string", "null"], "format": "date"},
    "delivery_deadline": {"type": ["string", "null"], "format": "date"},
    "absolute_constraints": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"enum": [
        "ZERO_INCREMENTAL_CASH_EXPENDITURE",
        "ZERO_UNPAID_OPERATIONAL_LABOUR",
        "NO_UNAUTHORISED_CONTACT_OR_COMMITMENTS",
        "NO_SIMULATED_EVIDENCE"
      ]}
    },
    "verified_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "evidence_reference"],
        "properties": {
          "description": {"type": "string", "minLength": 6},
          "evidence_reference": {"type": "string", "minLength": 3}
        },
        "additionalProperties": false
      }
    },
    "unknowns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 4}
    },
    "verification_requirements": {"type": "string", "minLength": 20}
  }
}
